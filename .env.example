# 复制这个文件为 .env，然后填入你自己的地址、密钥和模型名。
# 这里不含任何真实的密钥和模型名，请勿把填好的 .env 提交到仓库。

# 上游接口密钥。只保存在本地，不会进仓库也不会写进日志。
MOLLY_API_KEY=
# 上游地址，通常是 https://你的域名/v1
MOLLY_BASE_URL=
MOLLY_CHAT_PATH=/chat/completions

# 答题阶梯链，唯一的调度来源。
# 每档格式 = 模型名:思考强度:超时毫秒，用逗号分隔，可写多档。
# 第一档超时/报错/答案不合法，就自动切到第二档；第二档拿到完整的预算。
# 把 <强模型> 和 <备用模型> 换成你在模型广场看到的模型名。
MOLLY_CHAIN=<强模型>:max:90000,<备用模型>:medium:30000

# 难度探针：先用快模型判断这题该想多深，再让正式模型按这个深度作答。
# 默认关闭——探针本身也要一次上游请求，多数情况下比直接答题还慢。
MOLLY_PROBE=

# 额外候选模型，逗号分隔，接在链尾并沿用最后一档的超时，默认空（避免多耗 token）。
MOLLY_EXTRA_MODELS=
# 0=严格串行（前一档失败才切下一档，省 token）；1=并发竞速（更快但多耗 token）。
MOLLY_RACE=0
# 1=把上游请求排成一条队，一次只跑一道（OCS 关不掉并发时用）；0=不排队。
MOLLY_SERIALIZE=0
# 留空=每档用自己的思考强度（auto 则看探针）；填值则强制所有档位。
MOLLY_REASONING_EFFORT=
# 单题总预算，必须装得下每一档的超时之和。
TOTAL_TIMEOUT_MS=150000
# 限制模型输出长度，避免它先写一大段解释而拖过超时。
MOLLY_MAX_TOKENS=64
# 同题答案缓存时长（毫秒），只存内存，0 关闭。OCS 超时重试时可秒回。
MOLLY_CACHE_TTL_MS=1800000
PORT=8765
